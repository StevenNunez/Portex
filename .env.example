# Copiar a .env.local y completar. Ninguno de estos valores va al repo.
# En Vercel se cargan en Settings → Environment Variables.

# ── Supabase ────────────────────────────────────────────────────
# URL y anon key salen de Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: salta RLS. Solo del lado del servidor, nunca con prefijo
# NEXT_PUBLIC_ y nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ── URL pública de la app ───────────────────────────────────────
# Se usa en los correos de invitación y en los enlaces de las
# notificaciones push. En producción va el dominio real, con https.
NEXT_PUBLIC_APP_URL=https://portex.teolabs.app

# ── Notificaciones push del citófono (VAPID) ────────────────────
# Generar el par una sola vez con: npx web-push generate-vapid-keys
# Si se cambian, todos los residentes tienen que volver a suscribirse.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:portex@teolabs.app

# ── Correo saliente (SMTP) ──────────────────────────────────────
# Lo manda todo la app: invitaciones (personal y residentes),
# recuperación de clave y el correo de bienvenida. Supabase Auth solo
# manda la confirmación del registro.
# Puerto 465 = TLS directo. Con 587 u otro, nodemailer sube con STARTTLS.
# EMAIL_USER es con qué se autentica el SMTP; EMAIL_FROM es de quién dice
# venir el correo. Con Zoho son lo mismo; con un relay (Brevo, Resend…) el
# usuario es del proveedor y el remitente sigue siendo el nuestro.
#
#   Zoho:  HOST=smtp.zoho.com        PORT=465  USER=portex@teolabs.app
#   Brevo: HOST=smtp-relay.brevo.com PORT=587  USER=<login que da Brevo>
#          y EMAIL_PASS es la **clave SMTP** de Brevo, no la de la cuenta.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=portex@teolabs.app
EMAIL_FROM=portex@teolabs.app
EMAIL_PASS=

# ── Registro de errores ─────────────────────────────────────────
# La primera vez que aparece un error nuevo en producción, sale un aviso
# a esta casilla (si falta, a ADMIN_EMAIL, y si falta, a hola@teolabs.app).
# Los errores quedan en la tabla `errores` (migration_v17).
AVISO_ERRORES_A=
